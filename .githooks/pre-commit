#!/bin/sh
# Snelle check vóór elke commit: geen conflictmarkeringen, snelle unit-tests
# (scripts/precommit.js). De volledige testpoort zit in safe-push/pre-push.
# Overslaan alleen in noodgevallen: PODIUM_GEEN_PRECOMMIT=1 git commit …
# Actief via: git config core.hooksPath .githooks (npm install doet dat).
top="$(git rev-parse --show-toplevel)"
exec node "$top/scripts/precommit.js"
