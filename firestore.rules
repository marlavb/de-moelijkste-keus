rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Elke gebruiker heeft precies één document, met hun eigen auth-uid als
    // document-id. Alleen die ingelogde gebruiker mag het lezen of
    // schrijven — nooit iemand anders (en nooit een niet-ingelogde
    // bezoeker). Alles wat niet expliciet is toegestaan, is dicht.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
