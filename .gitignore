node_modules/
.DS_Store
debug/
scratch/

# Lokale scrape-output (working copy) is geen source — niet in git.
# Geankerd aan de root (/data/), anders matcht dit ook public/data/.
/data/

# public/data/shows.json, scrape-status.json en theaters.json zijn wél
# getrackt: de "Refresh data"-workflow commit ze, zodat de deploy-workflow ze zonder opnieuw te
# scrapen kan publiceren (en de volgende run op shows.json kan terugvallen).
# Eventuele andere bestanden in public/data/ blijven genegeerd.
public/data/*
!public/data/shows.json
!public/data/scrape-status.json
!public/data/theaters.json
