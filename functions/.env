# Instellingen voor de Cloud Functions (geen geheimen; die staan in Secret Manager).
# Het Pub/Sub-topic van de budgetmelding (zie docs/mail-en-billing-stop.md).
BUDGET_TOPIC=budget-meldingen
# true = de stopfunctie logt alleen. Sinds 12 okt 2026 false (test geslaagd, budget €5 gecontroleerd): de stop is echt.
DRY_RUN=false
