# Instellingen voor de Cloud Functions (geen geheimen; die staan in Secret Manager).
# Het Pub/Sub-topic van de budgetmelding (zie debug/stap5-instructies.md).
BUDGET_TOPIC=budget-meldingen
# true = de stopfunctie logt alleen. Pas na een geslaagde test op false zetten en opnieuw deployen.
DRY_RUN=true
